  <collision>
    <origin xyz="-0.07 -0.055 -0.0075" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find amr_description)/meshes/fl_roller_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="rr_joint" type="continuous">
  <origin xyz="-0.075 -0.095 0.0425" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rr_wheel_link_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="rl_joint" type="continuous">
  <origin xyz="-0.075 0.095 0.0425" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rl_wheel_link_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="lidar_joint" type="fixed">
  <origin xyz="0.0 0.0 0.1935" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_link_1"/>
</joint>

<joint name="camera_joint" type="fixed">
  <origin xyz="0.046567 -0.005 0.0925" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="camera_link"/>
</joint>


<joint name="fr_joint" type="fixed">
  <origin xyz="0.07 -0.055 0.0075" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="fr_roller_wheel_1"/>
</joint>

<joint name="fl_joint" type="fixed">
  <origin xyz="0.07 0.055 0.0075" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="fl_roller_wheel_1"/>
</joint>

</robot>
