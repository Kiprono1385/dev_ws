<link name="fr_roller_wheel_1">
  <inertial>
    <origin xyz="1.3877787807814457e-17 6.938893903907228e-18 -5.204170427930421e-18" rpy="0 0 0"/>
    <mass value="0.01387209506100743"/>
    <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.07 0.055 -0.0075" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find amr_description)/meshes/fr_roller_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.07 0.055 -0.0075" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find amr_description)/meshes/fr_roller_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="fl_roller_wheel_1">
  <inertial>
    <origin xyz="1.3877787807814457e-17 -6.938893903907228e-18 1.9949319973733282e-17" rpy="0 0 0"/>
    <mass value="0.01387209506100743"/>
    <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.07 -0.055 -0.0075" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find amr_description)/meshes/fl_roller_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
