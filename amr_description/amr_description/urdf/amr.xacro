  <collision>
    <origin xyz="0.075 0.095 -0.0425" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find amr_description)/meshes/rr_wheel_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="rl_wheel_link_1">
  <inertial>
    <origin xyz="-2.220446049250313e-16 0.015512778351276832 6.245004513516506e-17" rpy="0 0 0"/>
    <mass value="0.1440451194259502"/>
    <inertia ixx="8.7e-05" iyy="0.000137" izz="8.7e-05" ixy="-0.0" iyz="0.0" ixz="0.0"/>
