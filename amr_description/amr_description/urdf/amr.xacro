    <geometry>
      <mesh filename="file://$(find amr_description)/meshes/rl_wheel_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="lidar_link_1">
  <inertial>
    <origin xyz="-6.154361288395009e-18 -4.3080529018765064e-17 0.012000000000000038" rpy="0 0 0"/>
    <mass value="0.09790459345647239"/>
    <inertia ixx="3.5e-05" iyy="3.5e-05" izz="6e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.0 0.0 -0.1935" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find amr_description)/meshes/lidar_link_1.stl" scale="0.001 0.001 0.001"/>
